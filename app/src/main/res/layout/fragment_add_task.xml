<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <!-- Header Section -->
        <TextView
            android:id="@+id/title_add_task"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Add New Task"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/blue_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/subtitle_add_task"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Create a new task to manage"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/title_add_task"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="32dp"/>

        <!-- Task Title Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_title"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Task Title"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/blue_primary"
            app:hintTextColor="@color/blue_primary"
            app:layout_constraintTop_toBottomOf="@id/subtitle_add_task"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/taskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="textCapWords"
                android:paddingVertical="16dp"
                android:textSize="16sp"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Task Description Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_description"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Task Description"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/blue_primary"
            app:hintTextColor="@color/blue_primary"
            app:layout_constraintTop_toBottomOf="@id/input_layout_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/taskDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:textColor="@color/text_primary"
                android:inputType="textMultiLine"
                android:paddingVertical="16dp"
                android:textSize="16sp"
                android:gravity="top"
                android:maxLines="5"
                android:scrollbars="vertical"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Deadline Selection Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_deadline"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Select DateTime"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/blue_primary"
            app:hintTextColor="@color/blue_primary"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconTint="@color/blue_primary"
            app:layout_constraintTop_toBottomOf="@id/input_layout_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/taskDeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not set"
                android:textColor="@color/text_secondary"
                android:paddingVertical="16dp"
                android:textSize="16sp"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Image Selection Section -->
        <TextView
            android:id="@+id/image_section_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Task Image (Optional)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/blue_primary"
            app:layout_constraintTop_toBottomOf="@id/input_layout_deadline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <!-- Image Preview -->
        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:layout_constraintTop_toBottomOf="@id/image_section_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:scaleType="centerCrop"
            android:background="@color/blue_light"
            android:visibility="gone"
            android:contentDescription="Selected image preview" />

        <!-- Image Selection Buttons -->
        <LinearLayout
            android:id="@+id/image_buttons_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/imagePreview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectImage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Gallery"
                android:textSize="14sp"
                android:backgroundTint="@color/blue_primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_gallery"
                app:iconTint="@color/white"
                app:iconPadding="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureImage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Camera"
                android:textSize="14sp"
                android:backgroundTint="@color/blue_accent"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/white"
                app:iconPadding="4dp"/>

        </LinearLayout>

        <!-- Clear Image Button -->
        <TextView
            android:id="@+id/btnClearImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear Image"
            android:textColor="@color/error_red"
            android:textSize="14sp"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/image_buttons_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"/>

        <!-- Add Task Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addTaskButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Add Task"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/blue_primary"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_plus"
            app:iconTint="@color/white"
            app:iconPadding="8dp"
            android:letterSpacing="0.02"
            app:layout_constraintTop_toBottomOf="@id/btnClearImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <!-- Cancel Button -->
        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textStyle="normal"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/addTaskButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="32dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>